# SarcoScan: what never goes into git.
# Patient data, secrets and local environments stay on the machine that made them.

# --- Secrets and environment files (.env.example is the only one committed) ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.p8
*.pfx
*.jks
*.keystore
*.mobileprovision
*.secret
credentials.json
client_secret*.json
service_account*.json
token.json
# Anish's notes of the live credentials (database, Cloudinary, seed passwords)
cred.md

# --- Patient data and medical images ---
*.dcm
*.dicom
*.nii
*.nii.gz
*.mha
*.mhd
*.nrrd
*.svs
uploads/
**/uploads/
reports/
**/reports/
storage/
**/patient_data/
**/phi/
data/
ml/data/

# --- Databases ---
*.db
*.sqlite
*.sqlite3
*.dump
*.sql
*.sql.gz

# --- Model files ---
# Weights and checkpoints are ignored everywhere, except the final models the API loads
# from ml/models/ (committed on purpose so the hosted API can load them). Training
# checkpoints (*_last.pt) stay out even there.
*.onnx
*.pt
*.pth
*.ckpt
*.pkl
*.joblib
*.h5
*.bin
*.safetensors
*.weights
!ml/models/*.pt
!ml/models/*.joblib
ml/models/*_last.pt
ml/runs/
mlruns/
wandb/
.tensorboard/

# --- Node, Next.js, Expo (frontend/web, frontend/mobile) ---
node_modules/
.next/
out/
dist/
build/
coverage/
.expo/
web-build/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.apk
*.aab
*.ipa

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Operating system and editors ---
*.log
logs/
.DS_Store
._*
Thumbs.db
ehthumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# --- AI assistants' local files ---
.gemini/
.claude/settings.local.json

# --- Source folders that share a name with an ignored data folder above ---
# (for example the Next.js route src/app/reports/). Real patient files never live under src/.
!frontend/*/src/**/reports/
!frontend/*/src/**/uploads/
!frontend/*/src/**/data/
!frontend/*/src/**/storage/
!ml/reports/
