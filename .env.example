# Copy this file to .env and fill it in. Never commit .env.
# Keep production values in a second file, .env.prod, and load it with ENV_FILE=.env.prod.

# Any PostgreSQL: a hosted one (for example Supabase) or a local container.
# For a quick local run with no database server: sqlite:///./sarcoscan.db?check_same_thread=false
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/sarcoscan

# At least 32 random characters.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 32 random bytes each, base64-encoded.
# Generate: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# If FIELD_KEY is lost, every stored patient name and phone is unreadable. Back it up apart from the database.
FIELD_KEY=
HASH_KEY=

# Passwords for the three seed users, at least 10 characters each.
SEED_ADMIN_PASSWORD=
SEED_DOCTOR_PASSWORD=
SEED_TECHNICIAN_PASSWORD=

# Leave true. Browsers still accept the cookie on http://localhost.
# Set to false only to test over plain http on another address.
COOKIE_SECURE=true
